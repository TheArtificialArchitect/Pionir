+def _get(path: str, timeout: float) -> dict:
+    """A GET, for polling a running job. Named like _post so a test can neutralise it."""
+    req = urllib.request.Request(f"{_pionir_url()}{path}", method="GET")
+    with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310 - loopback only
+        return json.loads(resp.read().decode("utf-8"))
+
+
+def _running(resp: dict) -> bool:
+    """Pionir's unambiguous 'still working' signal: the explicit `running` flag, or the
+    status token galatea/hands.py also keys on. Reading a missing `ok` as failure is the
+    exact bug this backend had."""
+    return bool(resp.get("running")) or str(resp.get("status") or "") == "running"
+
+
+def _await_result(resp: dict, deadline: float) -> dict:
+    """Follow a still-running hand-off to its real result.
+
+    A 202 answer carries a task id and keeps working; GET /api/task/<id>?wait=60 returns
+    the job record, and once it is no longer running its ``result`` is the same object a
+    client that stayed connected would have got. Until then Daedalus is committing to the
+    forge -- which is what the diff is cut from -- so we wait for it up to our own
+    deadline instead of reading an empty diff and aborting.
+    """
+    if not _running(resp):
+        return resp
+    task_id = str(resp.get("task_id") or "")
+    if not task_id:
+        return resp
+    while time.monotonic() < deadline:
+        remaining = deadline - time.monotonic()
+        poll = max(1, int(min(_POLL_WAIT_SEC, remaining)))
+        try:
+            record = _get(f"/api/task/{task_id}?wait={poll}", poll + _REQUEST_MARGIN_SEC)
+        except (urllib.error.URLError, TimeoutError, OSError, ValueError):
+            continue  # a dropped poll is not the verdict; keep waiting until the deadline
+        if str(record.get("status") or "") == "running":
+            continue
+        result = record.get("result")
+        return result if isinstance(result, dict) else record
+    return resp  # our deadline passed with it still running: read as running, not a crash
+
+
