+def test_solve_sends_a_bounded_wait_and_marks_the_job_deferrable(monkeypatch):
+    """Audit item 1 + 4: a hand-off sends a server-side wait (so a long job is
+    answered in full when it can be) and marks itself deferrable (so a stressed
+    Bryo can pace it). Both were absent, which is why a long hand-off was reported
+    as failure and pressure never deferred."""
+    seen = {}
+    monkeypatch.setattr(dc, "_post", lambda path, body, t: seen.update(body=body, t=t) or {})
+    dc._solve("do the thing", 660.0)
+    assert seen["body"]["deferrable"] is True
+    assert 0 < seen["body"]["wait"] <= dc._PIONIR_MAX_WAIT_SEC
+    # our own request timeout must sit above the server-side wait, never below it
+    assert seen["t"] > seen["body"]["wait"]
+
+
+def test_a_running_handoff_is_polled_to_completion(monkeypatch):
+    """Audit item 1: on a 202 running answer Bryo polls the task rather than reading
+    an empty diff and aborting (its one attempt died at Pionir's 600 s limit)."""
+    monkeypatch.setattr(dc, "_post", lambda path, body, t:
+                        {"status": "running", "running": True, "task_id": "abc123"})
+    polls = []
+
+    def fake_get(path, timeout):
+        polls.append(path)
+        if len(polls) < 2:
+            return {"task_id": "abc123", "status": "running", "result": None}
+        return {"task_id": "abc123", "status": "done",
+                "result": {"ok": True, "commit": "deadbeef"}}
+
+    monkeypatch.setattr(dc, "_get", fake_get)
+    out = dc._solve("do the thing", 660.0)
+    assert out == {"ok": True, "commit": "deadbeef"}
+    assert len(polls) >= 2 and polls[0].startswith("/api/task/abc123?wait=")
+
+
+def test_a_finished_handoff_is_returned_without_polling(monkeypatch):
+    """When Pionir answers in full inside the wait there is nothing to poll."""
+    monkeypatch.setattr(dc, "_post", lambda path, body, t:
+                        {"ok": True, "result": {"ok": True, "commit": "x"}})
+    monkeypatch.setattr(dc, "_get", lambda path, timeout:
+                        (_ for _ in ()).throw(AssertionError("must not poll a finished job")))
+    out = dc._solve("do the thing", 660.0)
+    assert out["result"]["commit"] == "x"
+
