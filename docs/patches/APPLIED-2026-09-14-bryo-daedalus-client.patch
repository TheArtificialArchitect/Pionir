 DEFAULT_SOLVE_TIMEOUT_SEC = 1800.0
 
+# A hand-off that outlives Pionir's own wait is answered 202 {"status":"running",
+# "running":true,"task_id"} while the job runs on -- and reading an empty diff at that
+# point is exactly what left Bryo with 0 upgrade_authored (its one attempt died at
+# Pionir's 600 s limit). So send a server-side wait just under our own budget, and on a
+# still-running answer poll the task to completion rather than aborting. Values are
+# clamped to Pionir's own MAX_WAIT_SECONDS (600).
+_PIONIR_MAX_WAIT_SEC = 600.0
+_SERVER_WAIT_MARGIN_SEC = 30.0
+_REQUEST_MARGIN_SEC = 30.0
+_POLL_WAIT_SEC = 60.0
+
 
