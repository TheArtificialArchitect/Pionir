{
  "about": "What a secret looks like, for the Library's scrubbers. ONE source of truth, copied byte for byte: pionir-desktop shared/secret-patterns.json == Pionir src/pionir/secret_patterns.json. Both suites run the vectors against their own implementation (TypeScript and Python) and compare the two copies when both repos are on disk. Change it in the desktop, copy it to Pionir.",
  "version": 1,
  "replacement": "«redacted»",
  "patterns": [
    {
      "name": "private key block",
      "re": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?(?:-----END [A-Z ]*PRIVATE KEY-----|$)"
    },
    {
      "name": "OpenAI / Anthropic key",
      "re": "(?<![A-Za-z0-9])sk-(?:ant-|proj-|live-|test-)?[A-Za-z0-9_-]{20,}"
    },
    {
      "name": "GitHub token",
      "re": "(?<![A-Za-z0-9])(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,})"
    },
    {
      "name": "Slack token",
      "re": "(?<![A-Za-z0-9])xox[abposr]-[A-Za-z0-9-]{10,}"
    },
    {
      "name": "AWS access key id",
      "re": "(?<![A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}(?![A-Za-z0-9])"
    },
    {
      "name": "Google API key",
      "re": "(?<![A-Za-z0-9])AIza[0-9A-Za-z_-]{35}"
    },
    {
      "name": "Stripe key",
      "re": "(?<![A-Za-z0-9])(?:sk|rk|pk)_(?:live|test)_[A-Za-z0-9]{16,}"
    },
    {
      "name": "Stripe webhook secret",
      "re": "(?<![A-Za-z0-9])whsec_[A-Za-z0-9+/=]{20,}"
    },
    {
      "name": "Hugging Face token",
      "re": "(?<![A-Za-z0-9])hf_[A-Za-z0-9]{30,}"
    },
    {
      "name": "Telegram bot token",
      "re": "(?<![A-Za-z0-9])[0-9]{6,}:AA[A-Za-z0-9_-]{30,}"
    },
    {
      "name": "JWT",
      "re": "(?<![A-Za-z0-9])eyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"
    },
    {
      "name": "Discord bot token",
      "re": "(?<![A-Za-z0-9])[MNO][A-Za-z0-9_-]{23,27}\\.[A-Za-z0-9_-]{6}\\.[A-Za-z0-9_-]{27,40}(?![A-Za-z0-9])"
    },
    {
      "name": "password in a URL",
      "re": "([a-z][a-z0-9+.-]*://)[^\\s/:@]+:[^\\s/@]+@",
      "flags": "i",
      "replace": "{1}«redacted»@"
    },
    {
      "name": "bearer header",
      "re": "(Bearer)\\s+[A-Za-z0-9._~+/=-]{8,}",
      "replace": "{1} «redacted»"
    },
    {
      "name": "credential in a query",
      "re": "([?&](?:token|key|api_key|apikey|access_token|secret|password|sig|signature)=)[^\\s&\\\"'#]+",
      "flags": "i",
      "replace": "{1}«redacted»"
    },
    {
      "name": "named assignment",
      "re": "(?<![A-Za-z0-9])((?:[A-Za-z0-9]+[_.-])*(?:api[_-]?key|apikey|key|secret|token|password|passwd|pwd|authorization|credentials?|session[_-]?id)[\\\"']?\\s*[:=]\\s*[\\\"']?)([^\\s\\\"',;{}\\u00ab]{8,})",
      "flags": "i",
      "replace": "{1}«redacted»",
      "value_group": 2,
      "value_must": "secretish"
    }
  ],
  "secret_keys": {
    "about": "In structured data (a payload, a meta object): a string under a key named like a credential is redacted whole, whatever it looks like.",
    "re": "^(?:[A-Za-z0-9]+[_.-])*(?:api[_-]?key|apikey|key|secret|token|password|passwd|pwd|authorization|credentials?|session[_-]?id)$",
    "flags": "i",
    "min_length": 4
  },
  "secretish": "a value counts as secret-shaped when it holds a digit, an uppercase letter, or one of these symbols (a plain lowercase word does not)",
  "secretish_symbols": "-_+/=!@#$%^&*~",
  "entropy": {
    "about": "A bare token with no name: a run of token characters, long, drawn from at least three of lower/upper/digit/symbol, high Shannon entropy per character, and switching character class often (a random token does ~65% of the time; CamelCase words about 35%). Pure hex is left alone (ids, hashes); a run with a /-separated all-lowercase word of 4+ letters is a path, left alone.",
    "re": "(?<![A-Za-z0-9_+/=-])[A-Za-z0-9_+/=-]{32,}(?![A-Za-z0-9_+/=-])",
    "min_bits": 4.0,
    "min_class_changes": 0.42,
    "min_classes": 3
  },
