{
  "schema": 1,
  "about": "The one list of every port the estate's stack uses. pionir.ps1, Pionir Desktop (plan.ts, which parses this file's copy), the doctor and the tests all read it - a port number lives here and nowhere else a test cannot catch. A port is owned by exactly one entry; no two entries share one. `reserved` ports may never be given to a companion that a user can move. `launchers` are the programs that START the service (an empty list: something else starts it, we only know the port). `match` is a case-insensitive regex over the owning process's executable path + command line: a listener that does not match is somebody else's program on our port (brain 3.20: probing a port proves something listens, not that it is the thing). `probe` is the capability check: any HTTP answer below 500 means it is answering. `slow_start`: the port opens only after a model warm-up, so 'not answering yet' is 'warming', not DOWN.",
  "services": [
    {"id": "dashboard", "label": "Pionir dashboard", "ports": [8780], "launchers": ["pionir.ps1", "desktop"], "reserved": true,
     "match": "-m\\s+pionir\\s+server", "probe": {"kind": "http", "path": "/api/state"}},
    {"id": "ollama-gate", "label": "Ollama gate (inside the dashboard process)", "ports": [8774], "launchers": ["pionir.ps1", "desktop"], "reserved": true,
     "match": "-m\\s+pionir\\s+server", "probe": {"kind": "tcp"}},
    {"id": "galatea", "label": "Galatea (Moss)", "ports": [8799], "launchers": ["pionir.ps1", "desktop"], "reserved": true,
     "match": "galatea", "probe": {"kind": "http", "path": "/api/state"}},
    {"id": "daedalus", "label": "Daedalus", "ports": [8771], "launchers": ["pionir.ps1", "desktop"], "reserved": true,
     "match": "daedalus", "probe": {"kind": "http", "path": "/health"}},
    {"id": "melete", "label": "Melete", "ports": [8770], "launchers": ["pionir.ps1", "desktop"], "reserved": true,
     "match": "melete", "probe": {"kind": "http", "path": "/health"}},
    {"id": "crew", "label": "Crew direction API", "ports": [8782], "launchers": ["pionir.ps1", "desktop"], "reserved": true, "slow_start": true,
     "match": "-m\\s+pionir\\.crew", "probe": {"kind": "http", "path": "/api/health"}},
    {"id": "peter", "label": "Peter (The Web)", "ports": [8790], "launchers": ["pionir.ps1", "desktop"], "reserved": true,
     "match": "peter", "probe": {"kind": "http", "path": "/"}},
    {"id": "tunnel", "label": "VPS tunnel (loopback ends)", "ports": [18000, 18001, 18002], "launchers": ["pionir.ps1", "desktop"], "reserved": true,
     "match": "ssh(\\.exe)?\\s.*-L.*1800[0-2]", "probe": {"kind": "tcp"}},
    {"id": "ollama", "label": "Ollama", "ports": [11434], "launchers": [], "reserved": true,
     "match": "ollama", "probe": {"kind": "http", "path": "/api/version"}},
    {"id": "bryo-viewer", "label": "Bryo's viewer", "ports": [8787], "launchers": [], "reserved": true,
     "match": "bryo|viewer|terrarium", "probe": {"kind": "http", "path": "/"}},
    {"id": "hemera", "label": "Hemera dashboard", "ports": [8788], "launchers": [], "reserved": true,
     "match": "hemera|serve-local", "probe": {"kind": "http", "path": "/"}},
    {"id": "probability", "label": "Probability supervisor (held, not started by us)", "ports": [8791], "launchers": [], "reserved": true,
     "match": "probability", "probe": {"kind": "tcp"}},
    {"id": "hearth", "label": "Hearth simulation (Desktop companion)", "ports": [8801], "launchers": ["desktop"], "reserved": false,
     "match": "hearth", "probe": {"kind": "http", "path": "/"}},
    {"id": "proteus-relay", "label": "Proteus relay (Desktop companion)", "ports": [8792], "launchers": ["desktop"], "reserved": false,
     "match": "relay[\\\\/]server\\.py|proteus", "probe": {"kind": "http", "path": "/bots"}},
    {"id": "desktop-relay", "label": "Pionir Desktop relay (live profile)", "ports": [8830], "launchers": ["desktop"], "reserved": true, "scan": 10,
     "match": "pionir desktop|pionir-desktop|electron", "probe": {"kind": "tcp"}},
    {"id": "desktop-phone", "label": "Pionir Desktop phone listener (live profile)", "ports": [8831], "launchers": ["desktop"], "reserved": true,
     "match": "pionir desktop|pionir-desktop|electron", "probe": {"kind": "tcp"}},
    {"id": "desktop-relay-demo", "label": "Pionir Desktop relay (demo profile)", "ports": [8840], "launchers": ["desktop"], "reserved": true, "scan": 10,
     "match": "pionir desktop|pionir-desktop|electron", "probe": {"kind": "tcp"}},
    {"id": "desktop-phone-demo", "label": "Pionir Desktop phone listener (demo profile)", "ports": [8841], "launchers": ["desktop"], "reserved": true,
     "match": "pionir desktop|pionir-desktop|electron", "probe": {"kind": "tcp"}}
  ]
}
