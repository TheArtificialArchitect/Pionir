# Runtime state stays outside the repository.
PIONIR_STATE_ROOT=C:\Users\Ian\.pionir
# Bryo reads the same setting. Override only if both processes receive this value.
# PIONIR_GPU_LOCK_FILE=C:\Users\Ian\.pionir\resource\gpu.lock

# JSON array avoids shell parsing and supports Windows paths containing spaces.
# PIONIR_ATANI_COMMAND_JSON=["C:\\src\\Atani\\.venv\\Scripts\\atani.exe"]
# PIONIR_BRYO_STATUS_COMMAND_JSON=["C:\\src\\terrarium\\.venv\\Scripts\\python.exe","-m","bryo.status"]
# PIONIR_SPECIALISTS_FILE=C:\src\Pionir\specialists.toml

# RTX 3060 12 GB conservative admission budget.
PIONIR_TOTAL_VRAM_MB=12288
PIONIR_RESERVED_VRAM_MB=1024
PIONIR_CIRCUIT_FAILURE_THRESHOLD=3
PIONIR_CIRCUIT_RECOVERY_SECONDS=30

# Security pair (read-only status only; the offensive/defensive actions stay in the tools):
# PIONIR_NYX_STATUS_COMMAND_JSON=["C:/Users/Ian/AppData/Local/Programs/Python/Python312/Scripts/nyx.exe","status"]
# PIONIR_VOODOO_STATUS_COMMAND_JSON=["C:/src/Voodoo/.venv/Scripts/voodoo.exe","status"]
